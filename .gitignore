knowledge_base.db-wal
knowledge_base.db-shm
*.db-journal

# 渲染层验证 spike 的二进制产物（脚本与 README 纳入版本控制）
spike/out/

# 密钥
.env
*.secret
config/secrets.yaml

# Agent history (runtime artifacts)
.agent_history/

# Session context (runtime artifacts)
context/

# Pytest local temp
.pytest_tmp/

# 测试会话的运行态隔离目录（见 tests/conftest.py 的状态隔离段）
